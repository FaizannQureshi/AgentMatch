# Sign-in cookie. Generate a long random string.
SESSION_SECRET=

# Marketplace app. One agency install can write contacts in every subaccount.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://agentmatch-six.vercel.app/api/auth/crm/callback
# Filled after the one-time install if no database is connected yet.
GHL_REFRESH_TOKEN=

# Optional fallback. An agency private integration can read locations only.
GHL_AGENCY_TOKEN=

# Marketplace app shared secret. Required for the secure custom-page SSO path.
GHL_SSO_KEY=

# Secret query param on the custom menu link. Direct visits without it stay locked.
GHL_MENU_SECRET=

# Optional. Reject SSO sessions that are not this agency.
GHL_COMPANY_ID=

# Optional extra parent domains, comma-separated, for a white-label CRM host.
GHL_ALLOWED_HOSTS=

# Supabase project URL + anon key (used by the keep-alive cron REST ping).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Postgres connection string from Supabase → Project Settings → Database → URI.
# Prefer the Transaction pooler URI for Vercel (port 6543). Tokens + activity_log live here.
DATABASE_URL=

# Vercel Cron auth. Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional staff preview. Visit /?preview=TOKEN to open the directory without GHL.
GHL_PREVIEW_TOKEN=
GHL_PREVIEW_LOCATION_ID=
